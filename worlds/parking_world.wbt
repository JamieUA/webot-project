}

# ─── DRONE ──────────────────────────────────────────────────────────────────
DEF Drone Mavic2Pro {
  translation 30 0 0.5
  rotation 0 0 1 0
  controller "drone_controller"
  bodySlot [
    Receiver {
      name "ActionReceiver"
      channel 6
    }
    Emitter {
      name "StateEmitter"
      channel 4
    }
    Emitter {
      name "AlertEmitter"
      channel 8
    }
    Receiver {
      name "SupervisorReceiver"
      channel 9
    }
    DistanceSensor {
      translation 0.06 0.0332 0.003
      rotation 1 0 0 1.5708
      name "front left dist sonar"
      lookupTable [0.5 50 0  20 2000 0  40 4000 0.1]
      type "sonar"
    }
    DistanceSensor {
      translation 0.06 -0.033 0.003
      rotation 1 0 0 1.5708
      name "front right dist sonar"
      lookupTable [0.5 50 0  20 2000 0  40 4000 0.1]
      type "sonar"
    }
    DistanceSensor {
      translation -0.1364 0 -0.011
      rotation 0 -1 0 3.14159
      children [
        DEF DIST_SENSOR Pose {
          rotation 0 0 -0.9999999999999999 1.5707953071795862
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.5 0.5 0.5 roughness 0.8 metalness 0 }
              geometry Cylinder { height 0.004 radius 0.0035 }
            }
          ]
        }
      ]
      name "rear top dist sonar"
      lookupTable [0.5 50 0  16 1600 0  32 3200 0.1]
      type "sonar"
    }
    DistanceSensor {
      translation -0.1343 0 -0.044
      rotation 0 -1 0 3.14159
      children [USE DIST_SENSOR]
      name "rear bottom dist sonar"
      lookupTable [0.5 50 0  16 1600 0  32 3200 0.1]
      type "sonar"
    }
    DistanceSensor {
      translation -0.1309 0.016 -0.003
      rotation 0 0 1 1.5708
      children [USE DIST_SENSOR]
      name "left side dist sonar"
      lookupTable [0.5 50 0  10 1000 0]
      type "sonar"
    }
    DistanceSensor {
      translation -0.1309 -0.016 -0.003
      rotation 0.7071067811864082 -0.7071067811864082 0 -3.1415853071795863
      children [USE DIST_SENSOR]
      name "right side dist sonar"
      lookupTable [0.5 50 0  10 1000 0]
      type "sonar"
    }
    DistanceSensor {
      translation -0.0255 0 -0.0519
      rotation 0.5773509358537164 -0.5773479358540498 -0.5773519358536053 -2.0943853071795866
      name "down front dist sonar"
      lookupTable [0.5 50 0  11 1100 0  22 2200 0.1]
      type "sonar"
    }
    DistanceSensor {
      translation -0.1123 0 -0.0519
      rotation 0.5773509358537164 -0.5773479358540498 -0.5773519358536053 -2.0943853071795866
      name "down back dist sonar"
      lookupTable [0.5 50 0  11 1100 0  22 2200 0.1]
      type "sonar"
    }
    DistanceSensor {
      translation -0.026 0 0.02
      rotation 0 1 0 -1.5707953071795862
      name "top dist infrared"
      lookupTable [0.1 10 0  8 800 0]
      type "infra-red"
    }
  ]
  cameraSlot [
    Camera {
      rotation 0 1 0 1.5708
      width 400
      height 240
    }
  ]
}

