DEF World WorldInfo {
  title "Autonomous Parking Guard Drone"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.5773502691896258 0.5773502691896258 0.5773502691896258 2.0944
  position 0 -60 80
  near 0.2
  follow "Mavic 2 PRO"
  followType "None"
}
TexturedBackground {
  texture "noon_cloudy_countryside"
}
TexturedBackgroundLight {
  texture "noon_cloudy_countryside"
}

# ─── GROUND ─────────────────────────────────────────────────────────────────
DEF FlightArea Floor {
  name "flight_area_floor"
  translation 0 0 -0.005
  size 120 100
  appearance PBRAppearance {
    baseColor 0.22 0.22 0.22
    roughness 1
    metalness 0
  }
}

